<Window x:Class="EditorDeTexto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sin titulo" Height="450" Width="700">

    <!-- Aquí se enlazan los comandos de Abrir, Guardar y Ayuda con su código -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="Abrir_Executed" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="Guardar_Executed" />
        <CommandBinding Command="ApplicationCommands.Help" Executed="Ayuda_Executed" />
    </Window.CommandBindings>

    <DockPanel>

        <Menu DockPanel.Dock="Top"> <!-- Esto lo deja en la parte de arriba -->
            <MenuItem Header="Archivo">
                <MenuItem Header="Abrir" Command="ApplicationCommands.Open" />
                <MenuItem Header="Guardar" Command="ApplicationCommands.Save" />
            </MenuItem>
            <MenuItem Header="Editar"> <!-- Este item del menu tiene otros item dentre de el -->
                <MenuItem Header="Deshacer" Command="ApplicationCommands.Undo"
                          CommandTarget="{Binding ElementName=txtEditor}" />
                <MenuItem Header="Rehacer" Command="ApplicationCommands.Redo"
                          CommandTarget="{Binding ElementName=txtEditor}" />
                <Separator />
                <MenuItem Header="Copiar" Command="ApplicationCommands.Copy"
                          CommandTarget="{Binding ElementName=txtEditor}" />
                <MenuItem Header="Pegar" Command="ApplicationCommands.Paste"
                          CommandTarget="{Binding ElementName=txtEditor}" />
            </MenuItem>
            <MenuItem Header="Ayuda" Command="ApplicationCommands.Help">
            </MenuItem>
        </Menu>

        <!-- Al ser el último elemento del DockPanel, ocupa TODO el espacio libre -->
        <TextBox x:Name="txtEditor"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="14" />
    </DockPanel>
</Window>